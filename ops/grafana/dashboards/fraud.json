{
 "uid": "fraud-scoring",
 "title": "Fraud scoring",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Model version",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (version) (fraud_model_info)"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Predictions / s",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(fraud_predictions_total[1m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "p95 latency (/score)",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(fraud_request_seconds_bucket{endpoint=\"/score\"}[5m])) by (le))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Alerts per 10k",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 1
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1e4 * sum(rate(fraud_predictions_total{alert=\"true\"}[15m])) / sum(rate(fraud_predictions_total[15m]))"
    }
   ]
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Score PSI vs training",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 3
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(fraud_feature_psi{feature=\"score\"})"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "USD per 1M predictions (at current traffic)",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "decimals": 3
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(fraud_cost_per_hour_usd) / (sum(rate(fraud_predictions_total[1m])) * 3600) * 1e6"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Request latency",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(fraud_request_seconds_bucket{endpoint=\"/score\"}[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(fraud_request_seconds_bucket{endpoint=\"/score\"}[1m])) by (le))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum(rate(fraud_request_seconds_bucket{endpoint=\"/score\"}[1m])) by (le))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Throughput and alerts",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(fraud_predictions_total[1m]))",
     "legendFormat": "predictions/s"
    },
    {
     "refId": "B",
     "expr": "sum(rate(fraud_predictions_total{alert=\"true\"}[5m])) * 60",
     "legendFormat": "alerts/min"
    }
   ]
  },
  {
   "id": 9,
   "type": "bargauge",
   "title": "Fraud score: share of last 5 min traffic at or below each cut",
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0.95,
     "max": 1,
     "decimals": 2
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(fraud_score_bucket{le!=\"+Inf\"}[5m])) by (le) / scalar(sum(increase(fraud_score_count[5m])))",
     "legendFormat": "score <= {{le}}",
     "instant": true
    }
   ]
  },
  {
   "id": 10,
   "type": "bargauge",
   "title": "Drift: PSI per feature (last window)",
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 14
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sort_desc(fraud_feature_psi)",
     "legendFormat": "{{feature}}",
     "instant": true
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Alerted amount (USD per minute)",
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 12,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(fraud_alert_amount_total[5m])) * 60",
     "legendFormat": "alerted amount"
    }
   ]
  }
 ],
 "tags": [
  "mlops"
 ]
}